{
  "profiles": {
    "node": {
      "runner": "native",
      "commands": [
        [
          "npm",
          "ci"
        ],
        [
          "npm",
          "run",
          "test:integration"
        ],
        [
          "npm",
          "run",
          "build"
        ]
      ],
      "artifact_dir": "dist",
      "timeout": 600,
      "checks_dir": "checks",
      "checks_argv": [
        [
          "python3",
          "{checks}/js_syntax.py",
          "--allow-empty",
          "dist"
        ],
        [
          "python3",
          "{checks}/js_typecheck.py",
          ".",
          "--require-typecheck"
        ]
      ],
      "env": {
        "NODE_OPTIONS": "--max-old-space-size=1024"
      }
    }
  },
  "targets": {}
}
