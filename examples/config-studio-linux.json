{
  "profiles": {
    "nuxt-studio": {
      "runner": "native",
      "studio": true,
      "tester": true,
      "commands": [
        [
          "npm",
          "ci"
        ],
        [
          "npm",
          "run",
          "build"
        ]
      ],
      "artifact_dir": "release",
      "serve_argv": [
        "node",
        "release/server/index.mjs"
      ],
      "readiness_path": "/api/health",
      "timeout": 900,
      "qa_timeout": 120,
      "checks_dir": "checks",
      "checks_argv": [
        [
          "python3",
          "{checks}/secret_scan.py",
          "release"
        ],
        [
          "python3",
          "{checks}/js_syntax.py",
          "release"
        ]
      ],
      "env": {
        "DATABASE_URL": "file:{data}/app.db",
        "DATA_DIR": "{data}"
      }
    }
  },
  "targets": {}
}
